# The tree is built once per {derep} value:
#   all    every genome of the metapackage input (+ external genomes)
#   derep  only the dereplicated representatives (+ external genomes, which are already ANI clusters)
# The representatives list comes from the metapackage workflow; create it with
#   (cd ../metapackage_workflow && snakemake -s subworkflows/generate_metapackage.smk \
#        outputs/metadata/qc/dereplicated_genome_representatives.txt)
wildcard_constraints:
    derep = "derep|all"

DEREP_REPRESENTATIVES = Path(METAPACKAGE_CONFIG["derep_representatives"])
DEREP_MODES = list(TREE_CONFIG.get("derep_modes", ["all", "derep"]))
if "derep" in DEREP_MODES and not DEREP_REPRESENTATIVES.exists():
    print(f"WARNING: {DEREP_REPRESENTATIVES} not found; not building the 'derep' tree "
          "(create it with the metapackage workflow's dereplicate_genomes rule).")
    DEREP_MODES.remove("derep")


def derep_keep_list(wildcards):
    return str(DEREP_REPRESENTATIVES) if wildcards.derep == "derep" else []


rule all:
    input:
        expand(TREE_PATHS["rerooted_newick"], derep=DEREP_MODES),
        expand(TAXONOMY_PATHS["metadata"], derep=DEREP_MODES),
        expand(TREE_PATHS["diagnostics_dir"] + "/tree_diagnostics.html", derep=DEREP_MODES)


rule build_external_manifest_table:
    output:
        table = EXTERNAL_PATHS["metadata"]["manifest_table"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("build_external_manifest_table")
    run:
        with redirect_to_log(log[0]):
            out_path = Path(output.table)
            out_path.parent.mkdir(parents=True, exist_ok=True)

            rows = []
            for genome_acc, genome_path in EXTERNAL_GENOME_MAP.items():
                rows.append({"group": EXTERNAL_GROUP, "genome_acc": genome_acc, "genome_path": genome_path})

            if rows:
                pl.DataFrame(rows).write_csv(out_path, separator="\t")
            else:
                pl.DataFrame(schema={"group": pl.Utf8, "genome_acc": pl.Utf8, "genome_path": pl.Utf8}).write_csv(
                    out_path,
                    separator="\t",
                )


rule init_external_busco_lineage_cache:
    output:
        ready_marker = BUSCO_LINEAGE_READY
    params:
        lineage = BUSCO_CONFIG["lineage"],
        download_path = BUSCO_DOWNLOAD_PATH
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("init_external_busco_lineage_cache")
    conda:
        env("busco")
    shell:
        """
        exec > {log} 2>&1
        mkdir -p {params.download_path}
        mkdir -p $(dirname {output.ready_marker})
        if [ ! -s {params.download_path}/file_versions.tsv ] || [ ! -d {params.download_path}/lineages/{params.lineage} ]; then
            busco --download {params.lineage} --download_path {params.download_path}
        fi
        test -s {params.download_path}/file_versions.tsv
        test -d {params.download_path}/lineages/{params.lineage}
        touch {output.ready_marker}
        """


rule run_external_busco:
    input:
        genome         = lambda wildcards: EXTERNAL_GENOME_MAP[wildcards.genome_acc],
        # ancient(): editing the manifest-table or lineage-cache rules (or their environment)
        # must not re-run BUSCO on hundreds of genomes; the results do not depend on them
        manifest_table = ancient(EXTERNAL_PATHS["metadata"]["manifest_table"]),
        lineage_ready  = ancient(BUSCO_LINEAGE_READY)
    output:
        full_table = EXTERNAL_PATHS["busco"]["full_table"]
    params:
        lineage      = BUSCO_CONFIG["lineage"],
        mode         = BUSCO_CONFIG["mode"],
        out_path_dir = lambda wildcards: EXTERNAL_PATHS["busco"]["outdir"].format(group=wildcards.group),
        download_path = BUSCO_DOWNLOAD_PATH,
        offline       = True,
    threads: int(RESOURCE_CONFIG.get("busco_threads", 8))
    retries: TOTAL_ATTEMPTS
    resources: **BUSCO_RESOURCES
    log:
        log_path("run_external_busco", "group", "genome_acc")
    conda:
        env("busco")
    wildcard_constraints:
        group = EXTERNAL_GROUP
    script:
        str(METAPACKAGE_SCRIPTS / "run_busco.py")





