rule build_external_taxid_manifest:
    """(genome_acc, tax_id) for every genome with a known NCBI tax ID: metapackage genomes first, then external ones."""
    input:
        base_taxonomy      = str(METAPACKAGE_TAXONOMY),
        external_taxid_map = str(EXTERNAL_TAXID_MAP) if EXTERNAL_TAXID_MAP.exists() else []
    output:
        manifest = EXTERNAL_PATHS["metadata"]["taxid_manifest"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("build_external_taxid_manifest")
    run:
        with redirect_to_log(log[0]):
            sources = [pl.read_csv(input.base_taxonomy, separator="\t", infer_schema_length=0)]
            if input.external_taxid_map:
                sources.append(pl.read_csv(input.external_taxid_map, separator="\t", infer_schema_length=0))
            manifest = (
                pl.concat([df.select("acc", "ncbi_id") for df in sources])
                .filter(pl.col("ncbi_id").is_not_null() & (pl.col("ncbi_id") != ""))
                .unique(subset=["acc"], keep="first", maintain_order=True)
                .rename({"acc": "genome_acc", "ncbi_id": "tax_id"})
            )
            Path(output.manifest).parent.mkdir(parents=True, exist_ok=True)
            manifest.write_csv(output.manifest, separator="\t")


