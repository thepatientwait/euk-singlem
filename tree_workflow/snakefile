rule merge_gene_fastas:
    input:
        base_faa      = lambda wildcards: str(METAPACKAGE_SINGLEM_INPUT_DIR / f"{wildcards.gene}.faa"),
        # Use a file output (not the directory output) as the checkpoint dependency.
        # The sequences_dir can be pre-created during setup, which would otherwise
        # let Snakemake skip actual aggregation.
        external_ready = lambda wildcards: checkpoints.aggregate_external_busco_sequences.get().output.genome_input_genomes if USE_EXTERNAL else []
    output:
        merged_faa = MERGED_PATHS["gene_faa"]
    params:
        external_faa = lambda wildcards: str(EXTERNAL_GENE_PATH(wildcards.gene)),
        use_external = USE_EXTERNAL
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    script:
        str(TREE_SCRIPTS / "merge_gene_fastas.py")


