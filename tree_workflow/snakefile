        command_template = lambda wildcards: EUKCC_CONFIG["command_template"],
        db_path          = EUKCC_DB_PATH
    threads: int(EUKCC_CONFIG.get("threads", 8))
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    # resources: **RESOURCE_PROFILE(mem_scale=20)  # EukCC can be memory intensive, so we scale up memory for this step
