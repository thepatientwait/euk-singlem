rule prepare_eukcc_db:
    output:
        archive = EUKCC_DB_PATHS["archive"],
        extracted_dir = directory(EUKCC_DB_PATHS["extracted_dir"]),
        ready_marker = EUKCC_DB_PATHS["ready_marker"]
    params:
        root_dir = EUKCC_DB_PATHS["root_dir"],
        db_url = EUKCC_CONFIG["db_url"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    shell:
        """
        mkdir -p {params.root_dir}
        if [ ! -s {output.archive} ]; then
            wget -O {output.archive} {params.db_url}
        fi
        if [ ! -d {output.extracted_dir} ]; then
            tar -xzvf {output.archive} -C {params.root_dir}
        fi
        realpath {output.extracted_dir} > {output.ready_marker}
        """


rule run_external_eukcc:
    input:
        genome         = lambda wildcards: EXTERNAL_GENOME_MAP[wildcards.genome_acc],
