checkpoint aggregate_external_busco_sequences:
    input:
        quality_report = EXTERNAL_PATHS["metadata"]["checkm2"],
        metadata_files = [],
        busco_manifest = EXTERNAL_PATHS["metadata"]["busco_qc"],
        taxonomy      = EXTERNAL_PATHS["metadata"]["ncbi_rebuilt_taxonomy"]
    output:
        sequences_dir        = directory(EXTERNAL_PATHS["aggregate"]["sequences_dir"]),
        genome_input_genomes = EXTERNAL_PATHS["aggregate"]["genome_protein_files"],
        genome_input_hmms    = EXTERNAL_PATHS["aggregate"]["hmms_and_names"]
    params:
        min_sequences_per_gene = int(AGGREGATION_CONFIG.get("min_sequences_per_gene", 1)),
        allow_missing_taxonomy = bool(AGGREGATION_CONFIG.get("allow_missing_taxonomy", True)),
        # same switch as the QC rule above, so the marker count and the aggregated genes agree
        use_multi_copy = bool(BUSCO_CONFIG.get("use_multi_copy", False))
    threads: 8
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("aggregate_external_busco_sequences")
    script:
        str(METAPACKAGE_SCRIPTS / "aggregate_busco_sequences.py")



rule merge_gene_fastas:
    input:
        base_faa      = lambda wildcards: str(METAPACKAGE_SINGLEM_INPUT_DIR / f"{wildcards.gene}.faa"),
        # dereplicated tree: only these genomes are taken from the base input
        keep          = derep_keep_list,
        # Use a file output (not the directory output) as the checkpoint dependency.
        # The sequences_dir can be pre-created during setup, which would otherwise
        # let Snakemake skip actual aggregation.
        external_ready = lambda wildcards: checkpoints.aggregate_external_busco_sequences.get().output.genome_input_genomes if USE_EXTERNAL else []
    output:
        merged_faa = MERGED_PATHS["gene_faa"]
    params:
        external_faa = lambda wildcards: str(EXTERNAL_GENE_PATH(wildcards.gene)),
        use_external = USE_EXTERNAL
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("merge_gene_fastas", "derep", "gene")
    script:
        str(TREE_SCRIPTS / "merge_gene_fastas.py")


rule famsa:
    input:
        MERGED_PATHS["gene_faa"]
    output:
        TREE_PATHS["famsa"]
    # FAMSA uses every core it sees unless told otherwise, so pass -t: on a shared node an
    # unbounded run oversubscribes it. ~8k sequences per gene (the "all" tree) take ~1 CPU-hour.
    threads: 4
    retries: TOTAL_ATTEMPTS
    resources: **RESOURCE_PROFILE(runtime="4h")
    log:
        log_path("famsa", "derep", "gene")
    conda:
        env("align")
    shell:
        """
        exec > {log} 2>&1
        famsa -t {threads} {input} {output}
        """


rule bmge:
    input:
        TREE_PATHS["famsa"]
    output:
        TREE_PATHS["bmge"]
    params:
        h = ALIGNMENT_CONFIG["bmge_h"],
        g = ALIGNMENT_CONFIG["bmge_g"],
        matrix = ALIGNMENT_CONFIG["bmge_matrix"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("bmge", "derep", "gene")
    conda:
        env("align")
    shell:
        """
        exec > {log} 2>&1
        bmge -i {input} -of {output} -h {params.h} -g {params.g} -t AA -m {params.matrix}
        """


