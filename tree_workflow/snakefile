rule bmge:
    input:
        TREE_PATHS["famsa"]
    output:
        TREE_PATHS["bmge"]
    params:
        h = ALIGNMENT_CONFIG["bmge_h"],
        g = ALIGNMENT_CONFIG["bmge_g"],
        matrix = ALIGNMENT_CONFIG["bmge_matrix"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    shell:
        """
        bmge -i {input} -of {output} -h {params.h} -g {params.g} -t AA -m {params.matrix}
        """


rule generate_alignment:
    input:
        alignment_files = MERGED_BMGE_TARGETS
    output:
        concatinated_alignment = TREE_PATHS["alignment"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    run:
        from Bio import SeqIO
        from Bio.Seq import Seq
        from Bio.SeqRecord import SeqRecord

        alignment_files = input.alignment_files
        if isinstance(alignment_files, (str, Path)):
            alignment_files = [Path(alignment_files)]
        else:
            alignment_files = [Path(path) for path in alignment_files]

        valid_alignment_files = [path for path in alignment_files if path.is_file()]
        invalid_alignment_files = [path for path in alignment_files if not path.is_file()]
        if invalid_alignment_files:
            invalid_text = ", ".join(str(path) for path in invalid_alignment_files)
            if not valid_alignment_files:
                raise FileNotFoundError(f"No valid BMGE alignment files were found. Invalid inputs: {invalid_text}")
            print(f"Skipping invalid BMGE alignment inputs: {invalid_text}")

        species_df = pl.DataFrame(schema={"species_acc": str})
        gene_length = {}

        for alignment_file in valid_alignment_files:
            gene_name = alignment_file.name.split("_bmge")[0]
            species_gene_dict = {}
            for record in SeqIO.parse(str(alignment_file), "fasta"):
                species = record.id.split("|")[0]
                species_gene_dict.setdefault(species, str(record.seq))

            if not species_gene_dict:
                continue

            gene_index = f"gene_sequence-{gene_name}"
            gene_length[gene_index] = len(next(iter(species_gene_dict.values())))
            gene_df = (
                pl.DataFrame(
                    {
                        "species_acc": list(species_gene_dict.keys()),
                        gene_index: list(species_gene_dict.values()),
                    }
                )
                .join(species_df.select("species_acc"), on="species_acc", how="full", coalesce=True)
            )

            species_df = species_df.join(gene_df, on="species_acc", how="full", coalesce=True)

        species_df = (
            species_df.with_columns(
                [
                    pl.col(col).fill_null("-" * gene_length.get(col, 0))
                    for col in species_df.columns
                    if col.startswith("gene_sequence-")
                ]
            )
            .select(
                pl.col("species_acc"),
                pl.concat_str([pl.col("^gene_sequence-\\w+$")]).alias("full_gene_sequence"),
            )
        )

        final_seq_list = [
            SeqRecord(seq=Seq(species["full_gene_sequence"]), id=str(species["species_acc"]), description="")
            for species in species_df.iter_rows(named=True)
        ]

        SeqIO.write(final_seq_list, output.concatinated_alignment, "fasta")


rule build_tree:
    input:
        TREE_PATHS["alignment"]
    output:
        TREE_PATHS["newick"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    shell:
        """
        fasttree -nt {input} > {output}
        """

rule reroot_tree:
    input:
        tree = TREE_PATHS["newick"]
    output:
        rerooted_tree = TREE_PATHS["rerooted_newick"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    conda:
        TAXONOMY_ENV
    run:
        import dendropy

        tree = dendropy.Tree.get(path=input.tree, schema="newick", preserve_underscores=True)
        tree.reroot_at_midpoint(update_bipartitions=False)
        tree.write(path=output.rerooted_tree, schema="newick", unquoted_underscores=True)


