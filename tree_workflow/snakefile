rule tree_diagnostics:
    """Executed notebook on the supermatrix (and trees, if built): occupancy, gene overlap and
    divergence within vs between clades, clade fragmentation, multicopy heuristic check."""
    input:
        alignment = TREE_PATHS["alignment"],
        partitions = TREE_PATHS["partitions"],
        taxonomy = TAXONOMY_PATHS["conservative"]
    output:
        html = TREE_PATHS["diagnostics_dir"] + "/tree_diagnostics.html"
    params:
        notebook = str(ROOT / "notebooks" / "tree_diagnostics.ipynb"),
        scripts_dir = str(TREE_SCRIPTS),
        # read if present when the notebook runs; not rule inputs, so the notebook never waits for the tree
        trees = lambda wildcards: [TREE_PATHS["rerooted_newick"].format(derep=wildcards.derep)],
        merged_dir = lambda wildcards: str(Path(MERGED_PATHS["gene_faa"].format(derep=wildcards.derep, gene="x")).parent),
        busco_manifests = [
            (str(METAPACKAGE_BUSCO_QC), str(METAPACKAGE_ROOT)),
            (EXTERNAL_PATHS["metadata"]["busco_qc"], str(ROOT)),
        ],
        n_pairs = int(TREE_CONFIG.get("diagnostics_pairs", 2000)),
        max_multicopy_cases = int(TREE_CONFIG.get("diagnostics_multicopy_cases", 400))
    threads: 1
    retries: TOTAL_ATTEMPTS
    resources: **RESOURCE_PROFILE(mem_scale=2)
    log:
        log_path("tree_diagnostics", "derep")
    conda:
        env("diagnostics")
    script:
        str(TREE_SCRIPTS / "run_diagnostics_notebook.py")


rule build_tree:
    input:
        TREE_PATHS["alignment"]
    output:
        TREE_PATHS["newick"]
    params:
        # protein alignment: -lg -gamma (the old "-nt" treated amino acids as nucleotides and
        # ignored ~80% of the residues)
        args = TREE_CONFIG.get("fasttree_args", "-lg -gamma")
    threads: int(TREE_CONFIG.get("fasttree_threads", 8))
    retries: TOTAL_ATTEMPTS
    resources: **RESOURCE_PROFILE(runtime=str(TREE_CONFIG.get("fasttree_runtime", "8h")))
    log:
        log_path("build_tree", "derep")
    conda:
        env("align")
    shell:
        """
        exec > {log} 2>&1
        export OMP_NUM_THREADS={threads}
        FastTreeMP {params.args} {input} > {output}
        """

if OUTGROUP_ENABLED:
    rule reroot_tree:
        input:
            tree = TREE_PATHS["newick"]
        output:
            rerooted_tree = TREE_PATHS["rerooted_newick"]
        retries: TOTAL_ATTEMPTS
        resources: **DEFAULT_RESOURCES
        log:
            log_path("reroot_tree", "derep")
        conda:
            env("taxonomy")
        run:
            with redirect_to_log(log[0]):
                import dendropy

                # Load the tree with force-rooted option to properly handle tree state
                tree = dendropy.Tree.get(
                    path=input.tree, 
                    schema="newick", 
                    preserve_underscores=True, 
                    rooting="force-rooted"
                )

                # Filter keys from the global OUTGROUP_GENOME_MAP that exist in the tree
                valid_taxa = [acc for acc in OUTGROUP_GENOME_MAP.keys() if acc in tree.taxon_namespace.labels()]

                if valid_taxa and len(valid_taxa) > 1:
                    # Find the Most Recent Common Ancestor (MRCA) of these outgroup genomes
                    mrca_node = tree.mrca(taxon_labels=valid_taxa)
                
                    if mrca_node and mrca_node.edge:
                        edge_length = mrca_node.edge.length
                        length_split = 0.5 * edge_length if edge_length is not None else None
                    
                        # Reroot the tree at the edge leading to the MRCA clade
                        tree.reroot_at_edge(
                            mrca_node.edge, 
                            length1=length_split, 
                            length2=length_split, 
                            update_bipartitions=False
                        )

                else:
                    # If no valid outgroup taxa are found, fallback to midpoint rooting
                    tree.reroot_at_midpoint(update_bipartitions=False)

                # Write out the updated tree
                tree.write(path=output.rerooted_tree, schema="newick", unquoted_underscores=True)

else:
    rule reroot_tree:
        input:
            tree = TREE_PATHS["newick"]
        output:
            rerooted_tree = TREE_PATHS["rerooted_newick"]
        retries: TOTAL_ATTEMPTS
        resources: **DEFAULT_RESOURCES
        log:
            log_path("reroot_tree", "derep")
        conda:
            env("taxonomy")
        run:
            with redirect_to_log(log[0]):
                import dendropy

                tree = dendropy.Tree.get(path=input.tree, schema="newick", preserve_underscores=True)
                tree.reroot_at_midpoint(update_bipartitions=False)
                tree.write(path=output.rerooted_tree, schema="newick", unquoted_underscores=True)


rule prepare_taxonomy:
    """Split the taxonomy mapping into the files phylorank/assign_taxonomy read (no parsing: tax_status decides)."""
    input:
        taxonomy_mapping = MERGED_TAXONOMY_INPUT
    output:
        taxonomy = TAXONOMY_PATHS["prepared"],
        conservative_taxonomy = TAXONOMY_PATHS["conservative"],
        trusted_taxa = TAXONOMY_PATHS["trusted_taxa"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("prepare_taxonomy")
    run:
        with redirect_to_log(log[0]):
            mapping = pl.read_csv(input.taxonomy_mapping, separator="\t", infer_schema_length=0)
            missing = {"acc", "parsed_taxon_string", "tax_status"} - set(mapping.columns)
            if missing:
                raise ValueError(
                    f"{input.taxonomy_mapping} lacks columns {sorted(missing)}; rerun the taxonomy query rule"
                )
            mapping = mapping.unique(subset=["acc"], keep="first", maintain_order=True)

            def select_status(statuses):
                return (
                    mapping.filter(pl.col("tax_status").is_in(statuses))
                    .select(pl.col("acc").alias("genome_id"), pl.col("parsed_taxon_string").alias("taxonomy"))
                )

            complete = select_status(["complete"])            # all seven ranks: reference + trusted taxa
            usable = select_status(["complete", "partial"])   # anything with a rank below domain

            for path in (output.taxonomy, output.conservative_taxonomy, output.trusted_taxa):
                Path(path).parent.mkdir(parents=True, exist_ok=True)
            complete.write_csv(output.taxonomy, separator="\t", include_header=False)
            usable.write_csv(output.conservative_taxonomy, separator="\t", include_header=False)

            trusted = list(dict.fromkeys(
                taxon.strip() for lineage in complete["taxonomy"] for taxon in lineage.split(";")
            ))
            Path(output.trusted_taxa).write_text("\n".join(trusted) + ("\n" if trusted else ""), encoding="utf-8")


rule phylorank_decorate:
    input:
        tree = TREE_PATHS["rerooted_newick"],
        trusted_taxa = TAXONOMY_PATHS["trusted_taxa"],
        taxonomy = TAXONOMY_PATHS["prepared"]
    output:
        decorated_tree = TAXONOMY_PATHS["phylorank_tree"]
    params:
        command = TAXONOMY_CONFIG["phylorank_command"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("phylorank_decorate", "derep")
    conda:
        env("taxonomy")
    shell:
        """
        exec > {log} 2>&1
        mkdir -p $(dirname {output.decorated_tree})
        {params.command} decorate -t {input.trusted_taxa} --skip_rd_refine {input.tree} {input.taxonomy} {output.decorated_tree}
        """


rule phylorank_red:
    input:
        decorated_tree = TAXONOMY_PATHS["phylorank_tree"],
        trusted_taxa = TAXONOMY_PATHS["trusted_taxa"],
        taxonomy = TAXONOMY_PATHS["prepared"]
    output:
        red_tree = TAXONOMY_PATHS["red_tree"],
        red_cutoffs = TAXONOMY_PATHS["red_cutoffs"]
    params:
        command = TAXONOMY_CONFIG["phylorank_command"],
        red_dir = lambda wildcards: TAXONOMY_PATHS["red_dir"].format(derep=wildcards.derep)
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("phylorank_red", "derep")
    conda:
        env("taxonomy")
    shell:
        """
        exec > {log} 2>&1
        mkdir -p {params.red_dir}
        {params.command} outliers -t {input.trusted_taxa} {input.decorated_tree} {input.taxonomy} {params.red_dir}
        test -s {output.red_tree}
        test -s {output.red_cutoffs}
        """


rule assign_taxonomy:
    input:
        red_tree = TAXONOMY_PATHS["red_tree"],
        red_cutoffs = TAXONOMY_PATHS["red_cutoffs"],
        taxonomy = TAXONOMY_PATHS["conservative"]
    output:
        reference_taxonomy = TAXONOMY_PATHS["reference"],
        target_taxonomy = TAXONOMY_PATHS["target"],
        # split_map = TAXONOMY_PATHS["split_map"],
        # combine_map = TAXONOMY_PATHS["combine_map"],
        # partial_map = TAXONOMY_PATHS["partial_map"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("assign_taxonomy", "derep")
    conda:
        env("taxonomy")
    script:
        str(TREE_SCRIPTS / "assign_taxonomy_v5.py")


rule generate_metadata:
    input:
        reference_taxonomy = TAXONOMY_PATHS["reference"],
        target_taxonomy = TAXONOMY_PATHS["target"]
    output:
        metadata = TAXONOMY_PATHS["metadata"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    log:
        log_path("generate_metadata", "derep")
    conda:
        env("taxonomy")
    script:
        str(TREE_SCRIPTS / "generate_tree_metadata.py")
