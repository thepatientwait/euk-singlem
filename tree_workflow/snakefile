rule all:
    input:
        TREE_PATHS["rerooted_newick"],
        TAXONOMY_PATHS["metadata"]


rule build_external_manifest_table:
    output:
        table = EXTERNAL_PATHS["metadata"]["manifest_table"]
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    run:
        out_path = Path(output.table)
        out_path.parent.mkdir(parents=True, exist_ok=True)

        rows = []
        for genome_acc, genome_path in EXTERNAL_GENOME_MAP.items():
            rows.append({"group": EXTERNAL_GROUP, "genome_acc": genome_acc, "genome_path": genome_path})

        if rows:
            pl.DataFrame(rows).write_csv(out_path, separator="\t")
        else:
            pl.DataFrame(schema={"group": pl.Utf8, "genome_acc": pl.Utf8, "genome_path": pl.Utf8}).write_csv(
                out_path,
                separator="\t",
            )


rule init_external_busco_lineage_cache:
    output:
        ready_marker = BUSCO_LINEAGE_READY
    params:
        lineage = BUSCO_CONFIG["lineage"],
        download_path = BUSCO_DOWNLOAD_PATH
    retries: TOTAL_ATTEMPTS
    resources: **DEFAULT_RESOURCES
    conda:
        str(ROOT / "envs" / "busco.yaml")
    shell:
        """
        mkdir -p {params.download_path}
        mkdir -p $(dirname {output.ready_marker})
        if [ ! -s {params.download_path}/file_versions.tsv ] || [ ! -d {params.download_path}/lineages/{params.lineage} ]; then
            busco --download {params.lineage} --download_path {params.download_path}
        fi
        test -s {params.download_path}/file_versions.tsv
        test -d {params.download_path}/lineages/{params.lineage}
        touch {output.ready_marker}
        """


rule run_external_busco:
    input:
        genome         = lambda wildcards: EXTERNAL_GENOME_MAP[wildcards.genome_acc],
        manifest_table = EXTERNAL_PATHS["metadata"]["manifest_table"],
        lineage_ready  = BUSCO_LINEAGE_READY
    output:
        full_table = EXTERNAL_PATHS["busco"]["full_table"]
    params:
        lineage      = BUSCO_CONFIG["lineage"],
        mode         = BUSCO_CONFIG["mode"],
        out_path_dir = lambda wildcards: EXTERNAL_PATHS["busco"]["outdir"].format(group=wildcards.group),
        download_path = BUSCO_DOWNLOAD_PATH,
        offline       = True,
    threads: int(RESOURCE_CONFIG.get("busco_threads", 8))
    retries: TOTAL_ATTEMPTS
    resources: **BUSCO_RESOURCES
    conda:
        str(ROOT / "envs" / "busco.yaml")
    wildcard_constraints:
        group = EXTERNAL_GROUP
    script:
        str(METAPACKAGE_SCRIPTS / "run_busco.py")


