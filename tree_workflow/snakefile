# Outgroup (Asgard) accessions to drop from the concatenated alignment when the outgroup is disabled,
# since their sequences may still be present in previously aggregated/merged gene files.
OUTGROUP_EXCLUDE = set()
if not OUTGROUP_ENABLED and Path(OUTGROUP_CONFIG["genome_manifest"]).exists():
    OUTGROUP_EXCLUDE = set(pl.read_csv(OUTGROUP_CONFIG["genome_manifest"])["acc"].cast(pl.Utf8).to_list())
if OUTGROUP_ENABLED:
    OUTGROUP_MANIFEST = Path(OUTGROUP_CONFIG["genome_manifest"])
    OUTGROUP_GENOME_MAP = (
        dict(
            pl.read_csv(OUTGROUP_MANIFEST)
            .select(
                pl.col("acc").cast(pl.Utf8),
                pl.col("path").cast(pl.Utf8),
            )
            .iter_rows()
        )
    )


    EXTERNAL_GENOME_MAP.update(OUTGROUP_GENOME_MAP)


EXTERNAL_ACCESSIONS = sorted(EXTERNAL_GENOME_MAP.keys())
